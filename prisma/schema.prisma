generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Customers ----------

model Customer {
  id        String  @id @default(cuid())
  name      String // company name, or person's name for individuals
  email     String?
  phone     String?
  website   String?
  taxExempt Boolean @default(false)
  notes     String? // internal notes, never shown to the customer
  archived  Boolean @default(false)

  // Customer portal access: null = portal disabled. Generated on demand,
  // revocable. The token is the whole credential — no accounts/passwords.
  portalToken String? @unique

  contacts  Contact[]
  addresses Address[]
  quotes    Quote[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([archived])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum AddressType {
  BILLING
  SHIPPING
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       AddressType
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String      @default("US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------- Quotes ----------

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED // turned into an invoice
}

model Quote {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement()) // displayed as Q-<number>
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status     QuoteStatus @default(DRAFT)
  title      String? // short job description, e.g. "50 staff polos, 2-color front"
  issueDate  DateTime    @default(now())
  validUntil DateTime?

  // Money is always Decimal, never Float. Totals are computed in app code
  // (with tests) and persisted here so documents are stable historical records.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(6, 5) // fraction, e.g. 0.08250
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  notes String? // internal
  terms String? // shown on the quote

  lineItems QuoteLineItem[]
  invoices  Invoice[] // invoices created from this quote
  proofs    Proof[]
  job       Job? // production job, once the quote goes into production

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model QuoteLineItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(12, 4) // per-unit prices can be fractions of a cent
  taxable     Boolean @default(true)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2) // quantity * unitPrice, rounded; computed in app code
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
}

// ---------- Production ----------

// Ordered production stages for screen printing. ON_HOLD is a parking state
// outside the main flow; it isn't part of the linear progression.
enum JobStatus {
  QUEUED
  ARTWORK
  PREPRESS
  PRINTING
  CURING
  FINISHING
  QC
  READY
  SHIPPED
  ON_HOLD
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  RUSH
}

// A production job: the physical work order for an approved quote. One job
// per quote (the quote holds the line items to make and the approved proofs).
model Job {
  id      String @id @default(cuid())
  number  Int    @unique @default(autoincrement()) // displayed as JOB-<number>
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  status   JobStatus   @default(QUEUED)
  priority JobPriority @default(NORMAL)
  assignee String? // free text until a staff/auth system exists
  dueDate  DateTime?
  notes    String? // shop-floor notes

  // Set when the job first reaches SHIPPED, for lead-time reporting later.
  completedAt DateTime?

  movements StockMovement[] // stock consumed against this job
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
}

// ---------- Shipping ----------

enum Carrier {
  UPS
  USPS
  FEDEX
  DHL
  OTHER
}

enum ShipmentStatus {
  PENDING // created, not yet handed to the carrier
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// An outbound shipment for a production job. Carrier + tracking number are
// entered manually (from the carrier's own software); tracking URLs are
// derived, not fetched. Live rate/label APIs are intentionally not wired.
model Shipment {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  carrier        Carrier        @default(OTHER)
  service        String? // e.g. "Ground", "Priority Mail"
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  cost           Decimal        @default(0) @db.Decimal(12, 2)
  weightOz       Int? // package weight in ounces

  // Ship-to snapshot so the record is stable if the customer address changes.
  shipToName String?
  shipToLine1 String?
  shipToLine2 String?
  shipToCity  String?
  shipToState String?
  shipToPostalCode String?
  shipToCountry    String?

  shippedAt   DateTime?
  deliveredAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement()) // displayed as INV-<number>
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  sourceQuoteId String? // set when the invoice was converted from a quote
  sourceQuote   Quote?  @relation(fields: [sourceQuoteId], references: [id])

  status    InvoiceStatus @default(DRAFT)
  title     String?
  issueDate DateTime      @default(now())
  dueDate   DateTime?

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  taxRate    Decimal @default(0) @db.Decimal(6, 5)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2) // maintained by the payments stage; balance due = total - amountPaid

  notes String? // internal
  terms String? // shown on the invoice

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// ---------- Art approval ----------

enum ProofStatus {
  PENDING // uploaded, awaiting a decision
  APPROVED
  CHANGES_REQUESTED
}

// One uploaded artwork proof version for a quote. Files live on local disk
// (uploads/proofs/<id>.<ext>); this row is the metadata + approval record.
model Proof {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  version  Int // per-quote, 1-based
  fileName String // original upload name, display only
  fileExt  String // canonical extension we stored under, e.g. "png"
  mimeType String
  size     Int

  status    ProofStatus @default(PENDING)
  note      String? // shop's note shown to the customer
  feedback  String? // customer's comment (required for change requests)
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteId, version])
  @@index([quoteId])
}

// ---------- Pricing ----------

model PriceGrid {
  id        String  @id @default(cuid())
  name      String // e.g. "Screen print — standard"
  tierLabel String  @default("Colors") // what the tier axis means, e.g. "Colors" or "Stitch count (k)"
  notes     String?

  cells PriceCell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One cell of a grid: from minQuantity pieces up to the next break, at this
// tier, decoration costs unitPrice per piece. Prices resolved from grids are
// COPIED into documents — changing a grid never rewrites existing quotes.
model PriceCell {
  id     String    @id @default(cuid())
  gridId String
  grid   PriceGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  minQuantity Int
  tier        Int // e.g. number of print colors
  unitPrice   Decimal @db.Decimal(12, 4)

  @@unique([gridId, minQuantity, tier])
  @@index([gridId])
}

// Global garment-markup tiers: for a supplier cost >= minCost, sell at
// cost * multiplier. The applicable rule is the one with the highest
// minCost not exceeding the cost.
model MarkupRule {
  id         String  @id @default(cuid())
  minCost    Decimal @unique @db.Decimal(12, 2)
  multiplier Decimal @db.Decimal(6, 3) // e.g. 2.500

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OTHER
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(OTHER)
  reference  String? // check number, transaction id, etc.
  receivedAt DateTime      @default(now())
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(12, 4)
  taxable     Boolean @default(true)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// ---------- Inventory & purchasing ----------

model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  website String?
  account String? // our account number with this supplier
  notes   String?
  archived Boolean @default(false)

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model InventoryItem {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String // e.g. "Gildan 5000 - Black - L"
  unit        String  @default("each") // each, case, roll, etc.
  // On-hand is a cached column kept in sync via StockMovement rows in a
  // transaction; movements are the audit trail (like invoice.amountPaid).
  quantityOnHand Int    @default(0)
  reorderPoint   Int    @default(0)
  unitCost       Decimal @default(0) @db.Decimal(12, 4) // last known cost per unit
  archived       Boolean @default(false)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  movements StockMovement[]
  poLines   PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([supplierId])
}

enum StockReason {
  RECEIVED // from a purchase order
  CONSUMED // used by a production job
  ADJUSTMENT // manual correction (count, damage, etc.)
}

model StockMovement {
  id     String        @id @default(cuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  delta  Int // signed: +received, -consumed, +/- adjustment
  reason StockReason
  note   String?

  // Optional provenance links.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  poId  String?
  po    PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([jobId])
  @@index([poId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement()) // displayed as PO-<number>
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?
  notes      String?

  total Decimal @default(0) @db.Decimal(12, 2) // computed from lines in app code (tested)

  lines     PurchaseOrderLine[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id     String        @id @default(cuid())
  poId   String
  po     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  itemId String?
  item   InventoryItem? @relation(fields: [itemId], references: [id])

  description      String // snapshot; item may be renamed later
  quantity         Int     @default(1)
  quantityReceived Int     @default(0)
  unitCost         Decimal @default(0) @db.Decimal(12, 4)
  lineTotal        Decimal @default(0) @db.Decimal(12, 2) // quantity * unitCost, rounded
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poId])
  @@index([itemId])
}
