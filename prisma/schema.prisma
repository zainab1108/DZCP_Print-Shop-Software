generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Customers ----------

model Customer {
  id        String  @id @default(cuid())
  name      String // company name, or person's name for individuals
  email     String?
  phone     String?
  website   String?
  taxExempt Boolean @default(false)
  notes     String? // internal notes, never shown to the customer
  archived  Boolean @default(false)

  // Customer portal access: null = portal disabled. Generated on demand,
  // revocable. The token is the whole credential — no accounts/passwords.
  portalToken String? @unique

  contacts  Contact[]
  addresses Address[]
  quotes    Quote[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([archived])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

enum AddressType {
  BILLING
  SHIPPING
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       AddressType
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String      @default("US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------- Quotes ----------

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED // turned into an invoice
}

model Quote {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement()) // displayed as Q-<number>
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status     QuoteStatus @default(DRAFT)
  title      String? // short job description, e.g. "50 staff polos, 2-color front"
  issueDate  DateTime    @default(now())
  validUntil DateTime?

  // Money is always Decimal, never Float. Totals are computed in app code
  // (with tests) and persisted here so documents are stable historical records.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(6, 5) // fraction, e.g. 0.08250
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  notes String? // internal
  terms String? // shown on the quote

  lineItems QuoteLineItem[]
  invoices  Invoice[] // invoices created from this quote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model QuoteLineItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(12, 4) // per-unit prices can be fractions of a cent
  taxable     Boolean @default(true)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2) // quantity * unitPrice, rounded; computed in app code
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement()) // displayed as INV-<number>
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  sourceQuoteId String? // set when the invoice was converted from a quote
  sourceQuote   Quote?  @relation(fields: [sourceQuoteId], references: [id])

  status    InvoiceStatus @default(DRAFT)
  title     String?
  issueDate DateTime      @default(now())
  dueDate   DateTime?

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  taxRate    Decimal @default(0) @db.Decimal(6, 5)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2) // maintained by the payments stage; balance due = total - amountPaid

  notes String? // internal
  terms String? // shown on the invoice

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

// ---------- Pricing ----------

model PriceGrid {
  id        String  @id @default(cuid())
  name      String // e.g. "Screen print — standard"
  tierLabel String  @default("Colors") // what the tier axis means, e.g. "Colors" or "Stitch count (k)"
  notes     String?

  cells PriceCell[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One cell of a grid: from minQuantity pieces up to the next break, at this
// tier, decoration costs unitPrice per piece. Prices resolved from grids are
// COPIED into documents — changing a grid never rewrites existing quotes.
model PriceCell {
  id     String    @id @default(cuid())
  gridId String
  grid   PriceGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  minQuantity Int
  tier        Int // e.g. number of print colors
  unitPrice   Decimal @db.Decimal(12, 4)

  @@unique([gridId, minQuantity, tier])
  @@index([gridId])
}

// Global garment-markup tiers: for a supplier cost >= minCost, sell at
// cost * multiplier. The applicable rule is the one with the highest
// minCost not exceeding the cost.
model MarkupRule {
  id         String  @id @default(cuid())
  minCost    Decimal @unique @db.Decimal(12, 2)
  multiplier Decimal @db.Decimal(6, 3) // e.g. 2.500

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OTHER
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(OTHER)
  reference  String? // check number, transaction id, etc.
  receivedAt DateTime      @default(now())
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(12, 4)
  taxable     Boolean @default(true)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}
