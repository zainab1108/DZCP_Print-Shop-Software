# Copy this file to .env and fill in real values.
# PostgreSQL connection string used by Prisma (see prisma.config.ts).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/printshop"

# Secret used to sign admin session cookies. Generate a unique one:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Only used by `npm run create-admin` to create the first staff login.
# Set them inline when running that command rather than committing them.
# ADMIN_EMAIL="you@shop.com"
# ADMIN_PASSWORD="choose-a-strong-password"

# ---- Stripe online card payments (customer portal) ----
# Leave these unset to keep the "Pay now" button hidden; everything else works.
#
# Absolute base URL, used to build Stripe's return links. Read from env and
# never from the request Host header — the return URL carries a portal token.
# APP_URL="https://customdesk.io"
#
# Use a RESTRICTED key (Checkout Sessions: write, PaymentIntents: read) rather
# than the account secret key, so a server compromise can't issue refunds.
# Test keys start sk_test_/rk_test_; switch to live only after testing.
# STRIPE_SECRET_KEY="rk_test_..."
#
# Signing secret for the webhook endpoint pointed at
# <APP_URL>/api/stripe/webhook, from the Stripe dashboard. Without it the
# webhook fails closed and no payment is ever recorded.
# STRIPE_WEBHOOK_SECRET="whsec_..."
